{
  "name": "reelroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:api": "node --test tests/api-smoke.test.mjs",
    "screenshots": "node --experimental-strip-types tests/screenshots.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.26.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.18.0",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "@types/three": "^0.180.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  }
}
