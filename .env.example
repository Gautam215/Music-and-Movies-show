# Server-side data and movie services.
MONGODB_URI=
MONGODB_DB_NAME=reelscape
TMDB_READ_ACCESS_TOKEN=
YOUTUBE_API_KEY=
OMDB_API_KEY=
OMDB_MOVIE_IDS=tt3896198,tt1375666,tt0816692,tt0468569,tt6751668,tt0245429,tt0133093

# Spotify credentials are read by server routes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Public settings only; never put credentials in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_THEATER_3D_ENABLED=true
NEXT_PUBLIC_TICKET_SEAT_STREAM_URL=

# Optional shared rate-limit store. The in-memory fallback is process-local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_KEY_PREFIX=reelroom:api
RATE_LIMIT_FAIL_CLOSED=false

# Development-only QA fixture; the route is disabled outside development.
ENABLE_PREMIUM_TEST_FIXTURE=false
